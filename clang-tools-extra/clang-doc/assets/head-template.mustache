<head>
    <meta charset="utf-8"/>
    <title>{{Name}}</title>
    <script data-cfasync="false">
      (function() {
        const root = document.documentElement;
        const savedTheme = localStorage.getItem("theme");
        const theme = savedTheme || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        root.setAttribute("color-scheme", theme);
        window.__clangDocTheme = theme;
      })();
    </script>
    {{#Stylesheets}}
        <link rel="stylesheet" type="text/css" href="{{.}}"/>
    {{/Stylesheets}}
    {{#Scripts}}
        <script src="{{.}}"></script>
    {{/Scripts}}
    <script>
      const root = document.documentElement;
      const themeQuery = window.matchMedia("(prefers-color-scheme: dark)");
      // Follow system theme changes unless the user manually picked a theme.
      themeQuery.addEventListener("change", (event) => {
        if (localStorage.getItem("theme") !== null) {
          return;
        }
        root.setAttribute("color-scheme", event.matches ? "dark" : "light");
      });
    </script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=routine" />
</head>
