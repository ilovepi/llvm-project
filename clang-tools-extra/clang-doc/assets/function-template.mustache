<div id="{{USR}}" class="delimiter-container">
        {{#Template}}
        <pre><code class="code-clang-doc"><span class="k">template</span> &lt;{{^VerticalDisplay}}{{#Parameters}}{{Param}}{{^End}}, {{/End}}{{/Parameters}}{{/VerticalDisplay}}</code>{{#VerticalDisplay}}<span class="param-container">{{#Parameters}}<span class="param"><code class="code-clang-doc">{{Param}}{{^End}}, {{/End}}</code></span>{{/Parameters}}</span>{{/VerticalDisplay}}<code class="code-clang-doc">&gt;</code></pre>
        {{/Template}}
        {{! Function Prototype }}
        <pre><code class="code-clang-doc">{{#ReturnType}}{{>TypeLink}}{{/ReturnType}} <span class="nf">{{Name}}</span>{{#Template}}{{#Specialization}}&lt;{{#Parameters}}{{Param}}{{^SpecParamEnd}}, {{/SpecParamEnd}}{{/Parameters}}&gt;{{/Specialization}}{{/Template}} ({{^VerticalDisplay}}{{#Params}}{{#Type}}{{>TypeLink}}{{/Type}} <span class="n">{{Name}}</span>{{^ParamEnd}}, {{/ParamEnd}}{{/Params}}){{/VerticalDisplay}}</code>{{#VerticalDisplay}}<span class="param-container">{{#Params}}<span class="param"><code class="code-clang-doc">{{#Type}}{{>TypeLink}}{{/Type}}</code> <code class="code-clang-doc"><span class="n">{{Name}}</span>{{^ParamEnd}}, {{/ParamEnd}}</code></span>{{/Params}}</span><code class="code-clang-doc">)</code>{{/VerticalDisplay}}</pre>
        {{! Function Comments }}
        {{#Description}}
        <div class="doc-card">
            {{>Comments}}
        </div>
        {{/Description}}
        {{#Location}}
        {{>LocationPartial}}
        {{/Location}}
</div>
