    This file defines the template for functions/methods
}}
<div id="{{USR}}" class="delimiter-container">
        {{#Template}}
        <pre><code class="language-cpp code-clang-doc cd-sig"><span class="cd-kw">template</span> &lt;{{^VerticalDisplay}}{{#Parameters}}{{Param}}{{^End}}, {{/End}}{{/Parameters}}{{/VerticalDisplay}}</code>{{#VerticalDisplay}}<span class="param-container">{{#Parameters}}<span class="param"><code class="language-cpp code-clang-doc cd-sig">{{Param}}{{^End}}, {{/End}}</code></span>{{/Parameters}}</span>{{/VerticalDisplay}}<code class="language-cpp code-clang-doc cd-sig">&gt;</code></pre>
        {{/Template}}
        {{! Function Prototype }}
        <pre><code class="language-cpp code-clang-doc cd-sig">{{#ReturnType.Link}}<a class="cd-type" href="{{ReturnType.Link}}">{{ReturnType.QualName}}</a>{{/ReturnType.Link}}{{^ReturnType.Link}}<span class="cd-type">{{ReturnType.QualName}}</span>{{/ReturnType.Link}} <span class="cd-name">{{Name}}</span>{{#Template}}{{#Specialization}}&lt;{{#Parameters}}{{Param}}{{^SpecParamEnd}}, {{/SpecParamEnd}}{{/Parameters}}&gt;{{/Specialization}}{{/Template}} ({{^VerticalDisplay}}{{#Params}}{{#Type.Link}}<a class="cd-type" href="{{Type.Link}}">{{Type.QualName}}</a>{{/Type.Link}}{{^Type.Link}}<span class="cd-type">{{Type.QualName}}</span>{{/Type.Link}} <span class="cd-param">{{Name}}</span>{{^ParamEnd}}, {{/ParamEnd}}{{/Params}}){{/VerticalDisplay}}</code>{{#VerticalDisplay}}<span class="param-container">{{#Params}}<span class="param"><code class="language-cpp code-clang-doc cd-sig">{{#Type.Link}}<a class="cd-type" href="{{Type.Link}}">{{Type.QualName}}</a>{{/Type.Link}}{{^Type.Link}}<span class="cd-type">{{Type.QualName}}</span>{{/Type.Link}}</code> <code class="language-cpp code-clang-doc cd-sig"><span class="cd-param">{{Name}}</span>{{^ParamEnd}}, {{/ParamEnd}}</code></span>{{/Params}}</span><code class="language-cpp code-clang-doc cd-sig">)</code>{{/VerticalDisplay}}</pre>
        {{! Function Comments }}
        {{#Description}}
        <div class="doc-card">
            {{>Comments}}
        </div>
        {{/Description}}
        {{#Location}}
        <p>Defined at line {{LineNumber}} of file {{^FileURL}}{{Filename}}{{/FileURL}}{{#FileURL}}<a class="source-link" href="{{FileURL}}">{{Filename}}</a>{{/FileURL}}</p>
        {{/Location}}
</div>
